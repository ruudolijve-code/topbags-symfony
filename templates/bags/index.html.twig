{% extends 'base.html.twig' %}

{% block title %}
    {% if category is defined and category %}
        {{ category.name }} – Topbags
    {% else %}
        De mooiste leren tassen – Topbags
    {% endif %}
{% endblock %}

{% block body %}
<div
    class="w-full border-b border-gray-200 bg-grey-50"
    x-data="{ mobileFiltersOpen: false }"
>
    <div class="mx-auto max-w-7xl px-6 py-8">

        <header class="mb-8">
            <h1 class="mb-4 text-3xl font-bold">
                {% if category is defined and category %}
                    {{ category.menuLabel ?: category.name }}
                {% else %}
                    De mooiste tassen vind je bij Topbags
                {% endif %}
            </h1>

            {# Intro tekst boven productgrid #}
            {% if category is defined and category and category.introDescription %}
                <div class="rich-text-content max-w-3xl text-lg text-gray-600 leading-relaxed">
                    {{ category.introDescription|raw }}
                </div>
            {% elseif category is defined and category and category.description %}
                <div class="rich-text-content max-w-3xl text-lg text-gray-600 leading-relaxed">
                    {{ category.description|raw }}
                </div>
            {% else %}
                <div class="max-w-3xl text-lg text-gray-600 leading-relaxed">
                    Ontdek onze collectie leren tassen en fashionable bags.
                </div>
            {% endif %}
        </header>

        {# Mobiele toolbar #}
        <div class="mb-6 flex items-center justify-between gap-4 lg:hidden">
            <button
                type="button"
                @click="mobileFiltersOpen = true"
                class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-900 shadow-sm"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M6 12h12M10 18h4" />
                </svg>
                Filter kiezen
            </button>

            <div class=" mb-4 text-sm text-gray-500 text-right">
                    {{ pagination.totalItems }} modellen gevonden

                    {% if totalColors is defined and totalColors > 0 %}
                        <span class="text-gray-400">– in {{ totalColors }} kleuren</span>
                    {% endif %}

                    {% if totalVisibleVariants is defined and totalVisibleVariants > 0 %}
                        <span class="text-gray-400">– {{ totalVisibleVariants }} producten</span>
                    {% endif %}
                </div>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">

            {# Desktop filters #}
            <aside class="hidden rounded-xl bg-white p-6 shadow-sm lg:col-span-1 lg:block">
                <form method="get" class="space-y-6">
                    {% for categorySlug in activeCategories|default([]) %}
                        <input
                            type="hidden"
                            name="category[]"
                            value="{{ categorySlug }}"
                        >
                    {% endfor %}

                    {% if currentSort != 'recommended' %}
                        <input type="hidden" name="sort" value="{{ currentSort }}">
                    {% endif %}

                    {% if allowedFilters is defined and 'brands' in allowedFilters %}
                        {% include 'shop/filter/_filter_brands.html.twig' %}
                    {% endif %}

                    {% if allowedFilters is defined and 'color' in allowedFilters %}
                        {% include 'shop/filter/_filter_color.html.twig' %}
                    {% endif %}

                    {% if allowedFilters is defined and 'materials' in allowedFilters %}
                        {% include 'shop/filter/_filter_materials.html.twig' %}
                    {% endif %}

                    {% if allowedFilters is defined and 'cta' in allowedFilters %}
                        {% include 'shop/filter/_filter_cta.html.twig' %}
                    {% endif %}
                </form>
            </aside>

            {# Product grid #}
            <section class="lg:col-span-3">

                <div class="hidden lg:block mb-4 text-sm text-gray-500">
                    {{ pagination.totalItems }} modellen gevonden

                    {% if totalColors is defined and totalColors > 0 %}
                        <span class="text-gray-400">– in {{ totalColors }} kleuren</span>
                    {% endif %}

                    {% if totalVisibleVariants is defined and totalVisibleVariants > 0 %}
                        <span class="text-gray-400">– {{ totalVisibleVariants }} producten</span>
                    {% endif %}
                </div>

                {% if items is not empty %}
                    <style>
                        .style-guide-promo-copy { width: 66.666667%; }
                        @media (min-width: 640px) {
                            .style-guide-promo-copy { width: 50%; }
                        }
                    </style>
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                        {% for item in items %}
                            {% include 'shop/component/card/_card.html.twig' with {
                                context: 'bags',
                                product: item.product,
                                variant: item.variant,
                                master: item.master,
                                mediaPath: item.mediaPath,
                                availability: item.availability
                            } only %}

                            {% if
                                loop.index == 6
                                and pagination.page == 1
                                and 'damestassen' in activeCategories|default([])
                            %}
                                <a
                                    href="{{ path('style_guide_index') }}"
                                    class="group relative isolate min-h-96 overflow-hidden rounded-2xl shadow-sm ring-1 ring-black/5 transition duration-300 hover:shadow-lg md:col-span-2"
                                    style="background-color: #f7f0e9;"
                                    aria-label="Ontdek jouw ideale tas met de Topbags Stijlgids"
                                >
                                    <img
                                        src="{{ asset('images/stijlgids/style-guide-grid-banner.webp') }}"
                                        alt="Een stijlvolle selectie tassen voor de Topbags Stijlgids"
                                        loading="lazy"
                                        width="1774"
                                        height="887"
                                        class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                        style="object-position: 62% center;"
                                    >
                                    <div class="absolute inset-0" style="background: linear-gradient(90deg, #faf7f2 0%, #faf7f2 48%, rgba(250, 247, 242, 0.96) 55%, rgba(250, 247, 242, 0) 72%);"></div>

                                    <div class="style-guide-promo-copy relative flex h-full flex-col items-start justify-center px-5 py-8 sm:px-7 lg:px-8">
                                        <span class="text-xs font-semibold uppercase tracking-widest text-orange-600">
                                            Persoonlijke tassengids
                                        </span>
                                        <h2 class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-stone-950">
                                            Welke tas past écht bij jou?
                                        </h2>
                                        <p class="mt-4 text-sm leading-6 text-stone-700">
                                            Ontdek welke stijl, kleur en tas het beste bij jouw wensen passen.
                                        </p>
                                        <span
                                            class="mt-6 inline-flex items-center rounded-full px-5 py-3 text-sm font-semibold transition"
                                            style="background-color: #0c0a09; color: #ffffff;"
                                        >
                                            Start de Stijlgids
                                            <span class="ml-2" aria-hidden="true">→</span>
                                        </span>
                                    </div>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="rounded-xl bg-white p-8 text-gray-500 shadow-sm">
                        Geen producten gevonden.
                    </div>
                {% endif %}

                {% if pagination is defined and pagination.totalPages > 1 %}
                    <nav class="mt-10 flex flex-wrap items-center justify-center gap-2">
                        {% set routeName = app.request.attributes.get('_route') %}
                        {% set query = app.request.query.all %}

                        {% if pagination.hasPreviousPage %}
                            <a
                                href="{{ path(routeName, query|merge({ page: pagination.previousPage })) }}"
                                class="rounded-full border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50"
                            >
                                Vorige
                            </a>
                        {% endif %}

                        {% for p in pagination.pages %}
                            <a
                                href="{{ path(routeName, query|merge({ page: p })) }}"
                                class="rounded-full border px-4 py-2 text-sm {{ p == pagination.page ? 'border-black bg-black text-white' : 'border-gray-300 hover:bg-gray-50' }}"
                            >
                                {{ p }}
                            </a>
                        {% endfor %}

                        {% if pagination.hasNextPage %}
                            <a
                                href="{{ path(routeName, query|merge({ page: pagination.nextPage })) }}"
                                class="rounded-full border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50"
                            >
                                Volgende
                            </a>
                        {% endif %}
                    </nav>
                {% endif %}

            </section>
        </div>

        {# SEO tekst onder productgrid #}
        {% if category is defined and category and category.seoDescription %}
            <section class="mt-14 border-t border-gray-200 pt-10">
                <div class="rich-text-content max-w-4xl text-lg text-gray-700 leading-relaxed">
                    {{ category.seoDescription|raw }}
                </div>
            </section>
        {% endif %}
    </div>

    {# Mobiele filter overlay #}
    <div
        x-show="mobileFiltersOpen"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-[200] lg:hidden"
        style="display: none;"
    >
        <div
            class="fixed inset-0 bg-black/40"
            @click="mobileFiltersOpen = false"
        ></div>

        <div
            x-show="mobileFiltersOpen"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="translate-y-full"
            x-transition:enter-end="translate-y-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="translate-y-0"
            x-transition:leave-end="translate-y-full"
            class="fixed inset-x-0 top-0 bottom-0 z-[210] flex flex-col bg-white shadow-2xl"
            style="display: none;"
        >
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 shrink-0">
                <h2 class="text-lg font-semibold text-gray-900">
                    Filters
                </h2>

                <button
                    type="button"
                    @click="mobileFiltersOpen = false"
                    class="inline-flex items-center justify-center h-10 w-10 rounded-md border border-gray-300 bg-white text-gray-700"
                    aria-label="Sluit filters"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="get" class="flex-1 space-y-6 overflow-y-auto px-5 py-5">
                {% for categorySlug in activeCategories|default([]) %}
                    <input
                        type="hidden"
                        name="category[]"
                        value="{{ categorySlug }}"
                    >
                {% endfor %}

                {% if currentSort != 'recommended' %}
                    <input type="hidden" name="sort" value="{{ currentSort }}">
                {% endif %}

                {% if allowedFilters is defined and 'brands' in allowedFilters %}
                    {% include 'shop/filter/_filter_brands.html.twig' %}
                {% endif %}

                {% if allowedFilters is defined and 'color' in allowedFilters %}
                    {% include 'shop/filter/_filter_color.html.twig' %}
                {% endif %}

                {% if allowedFilters is defined and 'materials' in allowedFilters %}
                    {% include 'shop/filter/_filter_materials.html.twig' %}
                {% endif %}

                {% if allowedFilters is defined and 'cta' in allowedFilters %}
                    {% include 'shop/filter/_filter_cta.html.twig' %}
                {% endif %}

                <div class="sticky bottom-0 flex gap-3 border-t border-gray-200 bg-white pt-4 pb-2">
                    <a
                        href="{{ path(app.request.attributes.get('_route')) }}"
                        class="inline-flex flex-1 items-center justify-center rounded-lg border border-gray-300 px-4 py-3 text-sm font-medium text-gray-700"
                    >
                        Wis filters
                    </a>

                    <button
                        type="submit"
                        class="inline-flex flex-1 items-center justify-center rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white"
                    >
                        Toon resultaten
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
