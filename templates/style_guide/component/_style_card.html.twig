<label
    class="group relative block cursor-pointer"
    for="style-world-{{ styleWorld.value }}"
>
    <input
        id="style-world-{{ styleWorld.value }}"
        type="radio"
        name="style_world"
        value="{{ styleWorld.value }}"
        class="peer sr-only"
        {% if selectedStyleWorld and selectedStyleWorld.value == styleWorld.value %}
            checked
        {% endif %}
    >

    <div class="h-full rounded-3xl border border-gray-200 bg-white p-6 transition duration-200
                hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-lg
                peer-checked:border-gray-950 peer-checked:ring-2 peer-checked:ring-gray-950 peer-checked:ring-offset-2">

        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-orange-600">
                    {{ styleWorld.emotion }}
                </p>

                <h2 class="mt-2 text-xl font-bold text-gray-950">
                    {{ styleWorld.label }}
                </h2>
            </div>

            <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-white
                       peer-checked:border-gray-950"
                aria-hidden="true"
            >
                <span class="h-3 w-3 rounded-full bg-gray-950 opacity-0 transition group-has-[:checked]:opacity-100"></span>
            </span>
        </div>

        <p class="mt-4 text-sm leading-6 text-gray-600">
            {{ styleWorld.description }}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
            {% for characteristic in styleWorld.characteristics %}
                <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                    {{ characteristic }}
                </span>
            {% endfor %}
        </div>
    </div>
</label>