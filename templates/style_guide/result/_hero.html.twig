{% set heroImage = asset('images/stijlgids/' ~ styleWorld.slug ~ '.png') %}

<section class="bg-stone-100">
    <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8 lg:py-12">
        <div class="relative min-h-[760px] overflow-hidden rounded-[2rem] bg-[#f3eadb] shadow-sm ring-1 ring-stone-200 sm:min-h-[720px] lg:min-h-0">
            <img
                src="{{ heroImage }}"
                alt="Sfeerbeeld passend bij de stijl {{ styleWorld.name }}"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover object-[68%_center] lg:relative lg:h-auto lg:object-contain lg:object-center"
            >

            <div class="absolute inset-0 bg-gradient-to-t from-[#f3eadb] from-40% via-[#f3eadb]/90 via-65% to-transparent lg:bg-gradient-to-r lg:from-[#f3eadb] lg:from-10% lg:via-[#f3eadb]/95 lg:via-42% lg:to-transparent lg:to-68%" aria-hidden="true"></div>

            <div class="relative z-10 flex min-h-[760px] items-end px-6 py-10 sm:min-h-[720px] sm:px-10 sm:py-12 lg:absolute lg:inset-0 lg:min-h-0 lg:items-center lg:px-14 lg:py-12">
                <div class="max-w-xl lg:w-[46%]">
                    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-orange-600">Jouw stijlprofiel</p>

                    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl lg:text-6xl">
                        {{ styleWorld.name }}
                    </h1>

                    {% if styleWorld.emotion %}
                        <p class="mt-4 text-xl font-medium text-stone-700 sm:text-2xl">{{ styleWorld.emotion }}</p>
                    {% endif %}

                    {% if styleWorld.motto %}
                        <blockquote class="mt-6 border-l-2 border-orange-500 pl-5 text-lg leading-8 text-stone-800">“{{ styleWorld.motto }}”</blockquote>
                    {% endif %}

                    {% if styleWorld.resultText %}
                        <p class="mt-6 text-base leading-7 text-stone-700">{{ styleWorld.resultText }}</p>
                    {% elseif styleWorld.description %}
                        <p class="mt-6 text-base leading-7 text-stone-700">{{ styleWorld.description }}</p>
                    {% endif %}

                    <p class="mt-4 text-base leading-7 text-stone-700">
                        Op basis van jouw antwoorden hebben wij de tassen geselecteerd die het beste aansluiten bij jouw stijl, gebruik en wensen.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
