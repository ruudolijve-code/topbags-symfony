<section class="relative -mt-6 rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="profile-summary-title">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Jouw keuzes</p>
            <h2 id="profile-summary-title" class="mt-2 text-2xl font-semibold tracking-tight text-stone-950">Dit past bij jou</h2>
        </div>
        <a href="{{ path('style_guide_use') }}" class="inline-flex w-fit items-center justify-center rounded-full border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-900 transition hover:border-stone-950 hover:bg-stone-50">Profiel aanpassen</a>
    </div>

    <dl class="mt-7 flex flex-wrap gap-4">
        {% set profileChoices = [
            {label: 'Gebruik', value: useMoment.label},
            {label: 'Stijl', value: styleWorld.name},
            {label: 'Outfit', value: outfitPreference.label},
            {label: 'Formaat', value: bagRecommendationProfile ? bagRecommendationProfile.headline : (bagSizePreference ? bagSizePreference.label : null)},
            {label: 'Draagwijze', value: carryMethod.label},
            {label: 'Materiaal', value: materialPreference.label},
            {label: 'Prijsniveau', value: budgetPreference.label}
        ] %}
        {% for choice in profileChoices %}
            {% if choice.value %}
                <div class="rounded-full bg-stone-100 px-4 py-2 text-sm">
                    <dt class="inline font-medium text-stone-500">{{ choice.label }}</dt>
                    <dd class="ml-1 inline font-semibold text-stone-900">{{ choice.value }}</dd>
                </div>
            {% endif %}
        {% endfor %}
        {% for carryItem in carryItems %}
            {% if carryItem.code != 'laptop' %}
                <div class="rounded-full bg-orange-50 px-4 py-2 text-sm"><dt class="sr-only">Meenemen</dt><dd class="font-semibold text-orange-900">{{ carryItem.label }}</dd></div>
            {% endif %}
        {% endfor %}
        {% if laptopSize %}
            <div class="rounded-full bg-orange-50 px-4 py-2 text-sm"><dt class="sr-only">Meenemen</dt><dd class="font-semibold text-orange-900">Laptop {{ laptopSize.label }}</dd></div>
        {% endif %}
    </dl>

    {% if bagRecommendationProfile and (bagRecommendationProfile.description or bagRecommendationProfile.features) %}
        <div class="mt-6 border-t border-stone-200 pt-5">
            {% if bagRecommendationProfile.description %}<p class="max-w-3xl text-sm leading-6 text-stone-600">{{ bagRecommendationProfile.description }}</p>{% endif %}
            {% if bagRecommendationProfile.features %}
                <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-stone-700">
                    {% for feature in bagRecommendationProfile.features %}<li class="flex items-center gap-2"><span class="text-orange-600" aria-hidden="true">✓</span>{{ feature }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
</section>
