{% extends 'base.html.twig' %}

{% block title %}{{ question.title }} – Topbags{% endblock %}

{% block body %}
<section class="min-h-screen bg-stone-50">
    <div class="mx-auto max-w-7xl px-6 py-10 lg:px-8 lg:py-16">
        <div class="mx-auto max-w-3xl text-center">
            <a href="{{ path('style_guide_use') }}" class="text-sm font-medium text-gray-500 transition hover:text-black">← Vorige stap</a>
            <p class="mt-8 text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">Stap 2 van 8</p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl">{{ question.title }}</h1>
            {% if question.description %}<p class="mt-4 text-base leading-7 text-gray-600">{{ question.description }}</p>{% endif %}
        </div>
        <form method="post" class="mt-12">
            <input type="hidden" name="_token" value="{{ csrf_token('style_guide_audience') }}">
            {% if error %}<div class="mx-auto mb-8 max-w-2xl rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800" role="alert">{{ error }}</div>{% endif %}
            <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-3">
                {% for answer in answers %}
                    <label for="target-audience-{{ answer.code }}" class="group relative block cursor-pointer">
                        <input id="target-audience-{{ answer.code }}" type="radio" name="target_audience" value="{{ answer.code }}" class="peer sr-only" {% if selectedAnswer is same as(answer.code) %}checked{% endif %}>
                        <div class="h-full rounded-3xl border border-gray-200 bg-white p-6 transition hover:border-gray-400 hover:shadow-md peer-checked:border-black peer-checked:ring-2 peer-checked:ring-black peer-checked:ring-offset-2">
                            <h2 class="text-xl font-bold text-gray-950">{{ answer.label }}</h2>
                            {% if answer.description %}<p class="mt-4 text-sm leading-6 text-gray-600">{{ answer.description }}</p>{% endif %}
                        </div>
                    </label>
                {% endfor %}
            </div>
            <div class="mt-10 flex justify-center"><button type="submit" class="inline-flex min-w-56 items-center justify-center rounded-full bg-black px-8 py-4 text-sm font-semibold text-white transition hover:bg-orange-600">Volgende stap</button></div>
        </form>
    </div>
</section>
{% endblock %}
