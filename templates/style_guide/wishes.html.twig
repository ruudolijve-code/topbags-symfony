{% extends 'base.html.twig' %}

{% block title %}Vertel wat je zoekt – Topbags{% endblock %}

{% block body %}
<section class="min-h-screen bg-stone-50">
    <div class="mx-auto max-w-3xl px-6 py-10 text-center lg:py-16">
        <a href="{{ path('style_guide_budget') }}" class="text-sm font-medium text-gray-500 transition hover:text-black">← Vorige stap</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">Stap 9 van 9 · optioneel</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl">Wat maakt de ideale tas voor jou?</h1>
        <p class="mt-4 text-base leading-7 text-gray-600">Vertel bijvoorbeeld iets over je werk, stijl, favoriete details of wat je juist niet wilt. OpenAI gebruikt dit uitsluitend om binnen onze geschikte selectie persoonlijker te adviseren.</p>

        <form method="post" class="mt-10 text-left">
            <input type="hidden" name="_token" value="{{ csrf_token('style_guide_wishes') }}">
            {% if error %}<div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800" role="alert">{{ error }}</div>{% endif %}
            <label for="personal-wish" class="block text-sm font-semibold text-stone-900">Jouw toelichting</label>
            <textarea id="personal-wish" name="personal_wish" maxlength="1000" rows="7" class="mt-3 block w-full rounded-3xl border border-stone-300 bg-white px-5 py-4 text-base leading-7 shadow-sm focus:border-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-600/20" placeholder="Bijvoorbeeld: ik zoek een rustige leren werktas die professioneel oogt, niet te zwaar is en ruimte heeft voor mijn laptop. Ik hou van de kleur cognac">{{ personalWish }}</textarea>
            <p class="mt-3 text-sm text-stone-500">Vul niets persoonlijks of vertrouwelijks in. Je kunt deze stap ook leeg laten.</p>
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <button type="submit" class="inline-flex min-w-56 items-center justify-center rounded-full bg-black px-8 py-4 text-sm font-semibold text-white transition hover:bg-orange-600">Maak mijn persoonlijke advies</button>
                <button type="submit" name="skip" value="1" class="px-5 py-3 text-sm font-semibold text-stone-600 hover:text-black">Overslaan</button>
            </div>
        </form>
    </div>
</section>
{% endblock %}
