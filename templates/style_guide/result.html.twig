{% extends 'base.html.twig' %}

{% block title %}Jouw stijlprofiel: {{ styleWorld.name }} – Topbags{% endblock %}

{% block body %}
<section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-20">

        <div class="rounded-3xl bg-stone-100 px-6 py-10 sm:px-10 lg:px-16 lg:py-16">

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">
                Jouw stijlprofiel
            </p>

            <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl">
                {{ styleWorld.name }}
            </h1>

            {% if styleWorld.emotion %}
                <p class="mt-3 text-xl font-semibold text-gray-700">
                    {{ styleWorld.emotion }}
                </p>
            {% endif %}

            {% if styleWorld.motto %}
                <blockquote class="mt-8 max-w-3xl text-2xl font-medium leading-relaxed text-gray-950">
                    “{{ styleWorld.motto }}”
                </blockquote>
            {% endif %}

            {% if styleWorld.resultText %}
                <p class="mt-6 max-w-2xl text-base leading-7 text-gray-600">
                    {{ styleWorld.resultText }}
                </p>
            {% elseif styleWorld.description %}
                <p class="mt-6 max-w-2xl text-base leading-7 text-gray-600">
                    {{ styleWorld.description }}
                </p>
            {% endif %}

            <div class="mt-10 grid gap-5 md:grid-cols-2">

                {# Gebruiksmoment #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Gebruiksmoment
                            </p>

                            <p class="mt-2 text-lg font-bold text-gray-950">
                                {{ useMoment.label }}
                            </p>

                            {% if useMoment.description %}
                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ useMoment.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_use') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>
                </div>

                {# Outfit #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Favoriete outfits
                            </p>

                            <p class="mt-2 text-lg font-bold text-gray-950">
                                {{ outfitPreference.label }}
                            </p>

                            {% if outfitPreference.description %}
                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ outfitPreference.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_outfit') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>
                </div>

                {# Formaat #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Gewenst formaat
                            </p>

                            {% if bagRecommendationProfile %}
                                <p class="mt-2 text-lg font-bold text-gray-950">
                                    {{ bagRecommendationProfile.headline }}
                                </p>

                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ bagRecommendationProfile.description }}
                                </p>

                                {% if bagRecommendationProfile.features %}
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        {% for feature in bagRecommendationProfile.features %}
                                            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                                {{ feature }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                            {% elseif bagSizePreference %}
                                {# Tijdelijke fallback totdat de oude BagSizeCalculator verdwijnt #}
                                <p class="mt-2 text-lg font-bold text-gray-950">
                                    {{ bagSizePreference.label }}
                                </p>

                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ bagSizePreference.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_content') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>

                    {# Gekozen inhoud #}
                    <div class="mt-4 flex flex-wrap gap-2">
                        {% for carryItem in carryItems %}
                            {% if carryItem.code != 'laptop' %}
                                <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                    {{ carryItem.label }}
                                </span>
                            {% endif %}
                        {% endfor %}

                        {% if laptopSize %}
                            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                Laptop {{ laptopSize.label }}
                            </span>
                        {% endif %}
                    </div>

                    {# Alleen technische informatie in debugmodus #}
                    {% if debugBagFit|default(false) and bagFitProfile %}
                        <div class="mt-5 border-t border-black/10 pt-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Debug · berekend draagprofiel
                            </p>

                            <div class="mt-3 grid gap-x-6 gap-y-2 text-sm text-gray-700 sm:grid-cols-2">
                                <p>
                                    Min. breedte
                                    <strong class="ml-1 text-gray-950">
                                        {{ bagFitProfile.minimumWidthCm|number_format(1, ',', '.') }} cm
                                    </strong>
                                </p>

                                <p>
                                    Min. hoogte
                                    <strong class="ml-1 text-gray-950">
                                        {{ bagFitProfile.minimumHeightCm|number_format(1, ',', '.') }} cm
                                    </strong>
                                </p>

                                <p>
                                    Min. diepte
                                    <strong class="ml-1 text-gray-950">
                                        {{ bagFitProfile.minimumDepthCm|number_format(1, ',', '.') }} cm
                                    </strong>
                                </p>

                                <p>
                                    Benodigde inhoud
                                    <strong class="ml-1 text-gray-950">
                                        {{ bagFitProfile.minimumVolumeL|number_format(1, ',', '.') }} liter
                                    </strong>
                                </p>
                            </div>

                            {% if
                                bagFitProfile.requiresLaptopCompartment
                                or bagFitProfile.requiresA4Fit
                                or bagFitProfile.hasVerticalLoad
                            %}
                                <div class="mt-4 flex flex-wrap gap-2">

                                    {% if bagFitProfile.requiresLaptopCompartment %}
                                        <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                            Laptopvak vereist
                                            {% if bagFitProfile.requiredLaptopInch %}
                                                · {{ bagFitProfile.requiredLaptopInch|number_format(1, ',', '.') }} inch
                                            {% endif %}
                                        </span>
                                    {% endif %}

                                    {% if bagFitProfile.requiresA4Fit %}
                                        <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                            A4-formaat vereist
                                        </span>
                                    {% endif %}

                                    {% if bagFitProfile.hasVerticalLoad %}
                                        <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-gray-700">
                                            Ruimte voor hoge spullen
                                        </span>
                                    {% endif %}

                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {# Draagwijze #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Draagwijze
                            </p>

                            <p class="mt-2 text-lg font-bold text-gray-950">
                                {{ carryMethod.label }}
                            </p>

                            {% if carryMethod.description %}
                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ carryMethod.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_carry_method') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>
                </div>

                {# Materiaal #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Materiaal
                            </p>

                            <p class="mt-2 text-lg font-bold text-gray-950">
                                {{ materialPreference.label }}
                            </p>

                            {% if materialPreference.description %}
                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ materialPreference.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_material') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>
                </div>

                {# Prijsniveau #}
                <div class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
                                Prijsniveau
                            </p>

                            <p class="mt-2 text-lg font-bold text-gray-950">
                                {{ budgetPreference.label }}
                            </p>

                            {% if budgetPreference.description %}
                                <p class="mt-2 text-sm leading-6 text-gray-600">
                                    {{ budgetPreference.description }}
                                </p>
                            {% endif %}
                        </div>

                        <a
                            href="{{ path('style_guide_budget') }}"
                            class="shrink-0 text-sm font-semibold text-gray-600 transition hover:text-black"
                        >
                            Aanpassen
                        </a>
                    </div>
                </div>

            </div>

            <div class="mt-10 border-t border-black/10 pt-8">
                <h2 class="text-lg font-bold text-gray-950">
                    Jouw profiel is compleet
                </h2>

                <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">
                    We hebben jouw stijl, favoriete outfits, gebruiksmoment,
                    gewenste formaat, draagwijze, materiaalvoorkeur en prijsniveau
                    gecombineerd. De volgende stap is het selecteren van de tassen
                    die hier het beste bij aansluiten.
                </p>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-4">
                <a
                    href="{{ path('style_guide_budget') }}"
                    class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-7 py-3.5 text-sm font-semibold text-gray-900 transition hover:border-black"
                >
                    Vorige stap
                </a>

                <a
                    href="{{ path('style_guide_result') }}"
                    class="inline-flex items-center justify-center rounded-full bg-black px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-orange-600"
                >
                    Bekijk passende tassen
                </a>

                <form method="post" action="{{ path('style_guide_restart') }}">
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('style_guide_restart') }}"
                    >

                    <button
                        type="submit"
                        class="inline-flex items-center justify-center rounded-full px-3 py-3.5 text-sm font-semibold text-gray-500 transition hover:text-black"
                    >
                        Opnieuw beginnen
                    </button>
                </form>
            </div>

        </div>

    </div>
</section>
{% endblock %}