{# Alle actieve verkoopvarianten #}
{% set activeVariants = product.variants|filter(v => v.isActive) %}

{# =========================================================
   Eén representatieve variant per kleur.

   Hierdoor verschijnt zwart bijvoorbeeld maar één keer als
   kleurbadge, ook wanneer zwart in meerdere maten bestaat.
   ========================================================= #}
{% set colorVariants = {} %}

{% for activeVariant in activeVariants %}
    {% if activeVariant.color and activeVariant.supplierColorSlug %}
        {% set colorKey = activeVariant.supplierColorSlug %}

        {% if colorVariants[colorKey] is not defined %}
            {% set colorVariants = colorVariants|merge({
                (colorKey): activeVariant
            }) %}
        {% endif %}
    {% endif %}
{% endfor %}

{# =========================================================
   Maatvarianten binnen de momenteel gekozen kleur.

   Bij een riem:
   Optic White / 85 cm
   Optic White / 90 cm
   Optic White / 95 cm
   ========================================================= #}
{% set sizeVariants = activeVariants|filter(v =>
    v.size
    and (
        variant.supplierColorSlug
            ? v.supplierColorSlug == variant.supplierColorSlug
            : not v.supplierColorSlug
    )
) %}

{% set sizeVariants = sizeVariants|sort(
    (a, b) => a.size.sortOrder <=> b.size.sortOrder
) %}

{% set displayPrice = variant.displayPrice %}
{% set regularPrice = variant.price %}
{% set compareAtPrice = variant.compareAtPrice %}
{% set saleActive = variant.saleActive %}
{% set saleBadge = variant.discountBadge %}

<div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] bg-[#f4f1ea]">
    {% include 'product/_gallery_dual_museum.html.twig' with {
        product: product,
        variant: variant,
        mediaPath: mediaPath,
        imageBasePath: imageBasePath
    } %}
</div>

<div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] bg-[#f4f1ea] py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-start">

            <div class="w-full max-w-xl shrink-0 bg-white p-6 shadow-sm lg:p-8">
                {% if product.brand %}
                    <div class="text-xs tracking-[0.18em] uppercase text-gray-500">
                        {{ product.brand.name }}
                    </div>
                {% endif %}

                <h1 class="mt-3 text-2xl font-semibold text-gray-900 lg:text-3xl">
                    {{ product.name }}

                    {% if variant.supplierColorName %}
                        {{ variant.supplierColorName }}
                    {% endif %}
                </h1>

                {% set productDisplayName = (
                    (product.brand ? product.brand.name ~ ' ' : '')
                    ~ product.name
                )|trim %}

                {% if variant.heroIntro %}
                    <p class="mt-4 text-sm leading-6 text-gray-700">
                        {{ variant.heroIntro }}
                    </p>
                {% else %}
                    <p class="mt-4 text-sm leading-6 text-gray-700">
                        Ontdek de {{ productDisplayName }}{% if variant.supplierColorName %} in de kleur {{ variant.supplierColorName }}{% endif %}.
                        Bestel eenvoudig online bij Topbags of bekijk het model in onze winkel in Hengelo.
                    </p>
                {% endif %}

       {# =========================================================
        Producteigenschappen:
        maat, materiaal, formaat en kleur
        ========================================================= #}

        <div class="mt-8 space-y-3">

          {# =========================
            Maat
            ========================= #}
            {% if variant.size %}
                <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-slate-900">
                            Maat:
                        </h3>

                        <span class="text-sm text-slate-500">
                            {{ variant.size.name }}
                        </span>
                    </div>

                    {# Toon maatkeuzes alleen als meerdere maatvarianten beschikbaar zijn #}
                    {% if sizeVariants is defined and sizeVariants|length > 1 %}
                        <div class="mt-3 flex flex-wrap gap-3">
                            {% for sizeVariant in sizeVariants %}
                                {% if sizeVariant.size %}
                                    {% set isCurrentSize =
                                        sizeVariant.variantSku == variant.variantSku
                                    %}

                                    <a
                                        href="{{ path('product_show', {
                                            slug: product.slug,
                                            colorSlug: sizeVariant.supplierColorSlug ?: 'default',
                                            variantSku: sizeVariant.variantSku
                                        }) }}#product-focus"
                                        class="
                                            inline-flex min-h-10 min-w-16 items-center
                                            justify-center rounded-lg border px-4
                                            text-sm font-semibold transition
                                            {{ isCurrentSize
                                                ? 'border-slate-950 bg-white text-slate-950 shadow-sm ring-1 ring-slate-950'
                                                : 'border-slate-200 bg-white text-slate-600 hover:border-slate-500 hover:text-slate-950'
                                            }}
                                        "
                                        {% if isCurrentSize %}
                                            aria-current="page"
                                        {% endif %}
                                    >
                                        {{ sizeVariant.size.name }}
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="mt-2 text-xs text-slate-500">
                            Kies de gewenste maat.
                        </div>
                    {% endif %}
                </div>
            {% endif %}


            {# =========================
            Materiaal
            ========================= #}
            {% if product.material %}
                <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-slate-900">
                            Materiaal:
                        </h3>

                        <span class="text-sm text-slate-500">
                            {{ product.material.name }}
                        </span>
                    </div>
                </div>
            {% endif %}


            {# =========================
            Formaat / maatfamilie

            Dit zijn afzonderlijke producten, bijvoorbeeld dezelfde
            kofferserie in 55 cm, 69 cm en 75 cm. Dit staat los van de
            nieuwe variantmaat voor riemen en handschoenen.
            ========================= #}
            {% if
                product.productContext == 'shop'
                and sizeSiblings is defined
                and sizeSiblings|length > 1
            %}
                <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-slate-900">
                            Formaat:
                        </h3>

                        {% if
                            product.heightCm
                            and product.widthCm is defined
                            and product.widthCm
                            and product.depthCm is defined
                            and product.depthCm
                        %}
                            <span class="text-sm text-slate-500">
                                {{ product.heightCm|round(0, 'floor') }}
                                ×
                                {{ product.widthCm|round(0, 'floor') }}
                                ×
                                {{ product.depthCm|round(0, 'floor') }} cm
                            </span>
                        {% elseif product.heightCm %}
                            <span class="text-sm text-slate-500">
                                {{ product.heightCm|round(0, 'floor') }} cm
                            </span>
                        {% endif %}
                    </div>

                    <div class="mt-3 flex flex-wrap gap-3">
                        {% for sibling in sizeSiblings %}
                            {% set siblingVariant =
                                sibling.masterVariant is defined
                                and sibling.masterVariant
                                    ? sibling.masterVariant
                                    : sibling.variants|filter(v => v.isActive)|first
                            %}

                            {% if siblingVariant and sibling.heightCm %}
                                {% set isCurrentProduct = sibling.id == product.id %}

                                <a
                                    href="{{ path('product_show', {
                                        slug: sibling.slug,
                                        colorSlug: siblingVariant.supplierColorSlug ?: 'default',
                                        variantSku: siblingVariant.variantSku
                                    }) }}#product-focus"
                                    class="
                                        inline-flex min-h-10 min-w-[92px]
                                        items-center justify-center rounded-lg border
                                        px-5 text-sm font-semibold transition

                                        {{ isCurrentProduct
                                            ? 'border-slate-950 bg-white text-slate-950 shadow-sm ring-1 ring-slate-950'
                                            : 'border-slate-200 bg-white text-slate-500 hover:border-slate-400 hover:text-slate-800'
                                        }}
                                    "
                                    {% if isCurrentProduct %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    {{ sibling.heightCm|round(0, 'floor') }} cm

                                    {% if
                                        sibling.expandable is defined
                                        and sibling.expandable
                                    %}
                                        expandable
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}


            {# =========================
            Kleur
            ========================= #}
            {% if colorVariants|length > 0 %}
                <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-slate-900">
                            Kleur:
                        </h3>

                        {% if variant.supplierColorName %}
                            <span class="text-sm text-slate-500">
                                {{ variant.supplierColorName }}
                            </span>
                        {% endif %}
                    </div>

                    {% if colorVariants|length > 1 %}
                        <div class="mt-3 flex flex-wrap gap-3">
                            {% for colorSlug, colorVariant in colorVariants %}
                                {% set isCurrentColor =
                                    colorSlug == variant.supplierColorSlug
                                %}

                                <a
                                    href="{{ path('product_show', {
                                        slug: product.slug,
                                        colorSlug: colorVariant.supplierColorSlug,
                                        variantSku: colorVariant.variantSku
                                    }) }}#product-focus"
                                    class="
                                        h-8 w-8 rounded-full border transition

                                        {{ isCurrentColor
                                            ? 'border-slate-950 ring-2 ring-slate-950 ring-offset-2'
                                            : 'border-slate-300 hover:border-slate-500'
                                        }}
                                    "
                                    style="background-color: {{ colorVariant.color.hex }}"
                                    aria-label="{{ colorVariant.supplierColorName }}"
                                    title="{{ colorVariant.supplierColorName }}"
                                    {% if isCurrentColor %}
                                        aria-current="page"
                                    {% endif %}
                                ></a>
                            {% endfor %}
                        </div>

                        <div class="mt-2 text-xs text-slate-500">
                            Klik op een andere kleur om deze te bekijken.
                        </div>
                    {% endif %}
                </div>
            {% endif %}

        </div>

                {% if displayPrice %}
                    <div class="mt-6">
                        {% if saleActive and saleBadge %}
                            <div class="mb-3">
                                <span class="badge-sale">
                                    {{ saleBadge }}
                                </span>
                            </div>
                        {% endif %}

                        <div class="flex flex-wrap items-baseline gap-3">
                            <span class="text-xl font-semibold {{ saleActive ? 'text-red-600' : 'text-gray-900' }}">
                                € {{ displayPrice|number_format(2, ',', '.') }}
                            </span>

                            {% if saleActive %}
                                <span class="text-base text-gray-500 line-through">
                                    € {{ regularPrice|number_format(2, ',', '.') }}
                                </span>
                            {% elseif compareAtPrice and compareAtPrice > displayPrice %}
                                <span class="text-sm text-gray-500">
                                    adviesprijs
                                    <span class="line-through">
                                        € {{ compareAtPrice|number_format(2, ',', '.') }}
                                    </span>
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if availability %}
                    <div class="mt-4 text-sm">
                        {% if availability.status == 'in_stock' %}
                            <span class="font-semibold text-emerald-700">Op voorraad</span>
                            <span class="text-gray-500">– {{ availability.deliveryLabel }}</span>
                        {% elseif availability.status == 'backorder' %}
                            <span class="font-semibold text-amber-700">Op voorraad</span>
                            <span class="text-gray-500">– {{ availability.deliveryLabel }}</span>
                        {% else %}
                            <span class="font-semibold text-gray-500">Tijdelijk uitverkocht</span>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
                    {% if availability and availability.status == 'out_of_stock' %}
                        <button type="button"
                                disabled
                                class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-gray-100 px-6 py-3 text-sm font-semibold text-gray-400">
                            Tijdelijk uitverkocht
                        </button>
                    {% else %}
                        <form
                            method="post"
                            action="{{ path('cart_add') }}"
                            class="inline-flex js-meta-add-to-cart"
                            data-meta-content-id="{{ variant.variantSku|e('html_attr') }}"
                            data-meta-value="{{ variant.displayPrice|default(variant.price)|default(0)|number_format(2, '.', '') }}"
                            data-meta-currency="EUR"
                        >
                            <input type="hidden" name="variantSku" value="{{ variant.variantSku }}">
                            <input type="hidden" name="qty" value="1">

                            <button type="submit"
                                    class="inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
                                    style="background-color: #ea7600;">
                                In winkelwagen
                            </button>
                        </form>
                    {% endif %}

                    <a href="#details"
                       class="text-sm font-semibold text-gray-600 transition hover:text-gray-900">
                        Bekijk details →
                    </a>
                </div>
            </div>

            <aside class="w-full max-w-md rounded-2xl bg-[#f4f1ea] p-6 shadow-[0_18px_45px_rgba(15,23,42,0.08)] lg:mt-8">

                <div class="text-xs font-semibold tracking-[0.18em] uppercase text-gray-500">
                    {{ purchaseBenefits.title }}
                </div>

                <ul class="mt-5 space-y-4 text-sm leading-6 text-gray-700">
                    {% for benefit in purchaseBenefits.items %}
                        <li class="flex gap-3">
                            <span class="mt-0.5 shrink-0 text-base font-bold text-emerald-700">
                                ✓
                            </span>

                            <span>{{ benefit }}</span>
                        </li>
                    {% endfor %}

                    {% if product.brand %}
                        <li class="flex gap-3">
                            <span class="mt-0.5 shrink-0 text-base font-bold text-emerald-700">
                                ✓
                            </span>

                            <span>
                                Officieel dealer van {{ product.brand.name }}
                            </span>
                        </li>
                    {% endif %}
                </ul>

                {% set googleReviews = google_business_reviews() %}

                {% if googleReviews %}
                    <div class="mt-6 border-t border-black/10 pt-5">
                        <a
                            href="{{ googleReviews.googleMapsUrl }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-4 rounded-xl bg-white px-5 py-4 transition hover:shadow-sm"
                            aria-label="Bekijk onze Google-reviews"
                        >
                            <div class="min-w-0 flex-1">

                                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">

                                    <span class="inline-flex h-5 w-16 shrink-0 items-center overflow-hidden
                                                [&_svg]:!h-5 [&_svg]:!w-auto [&_svg]:max-w-full">
                                        {% include 'partials/icons/google.svg.twig' %}
                                    </span>

                                    <div class="flex items-center gap-2">
                                        <span
                                            class="text-base tracking-wide text-amber-500"
                                            aria-label="{{ googleReviews.rating|number_format(1, ',', '.') }} van 5 sterren"
                                        >
                                            ★★★★★
                                        </span>

                                        <strong class="text-lg font-semibold text-gray-900">
                                            {{ googleReviews.rating|number_format(1, ',', '.') }}
                                        </strong>

                                        <span class="text-base text-gray-500">
                                            ({{ googleReviews.reviewCount }})
                                        </span>
                                    </div>

                                </div>

                                <p class="mt-2 text-sm leading-6 text-gray-500">
                                    Klanten beoordelen Holtkamp Tassen &amp; Koffers en Topbags.nl via Google
                                </p>

                            </div>

                            <svg
                                class="h-5 w-5 shrink-0 text-gray-400 transition group-hover:translate-x-0.5 group-hover:text-gray-600"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 5l7 7-7 7"
                                />
                            </svg>
                        </a>
                    </div>
                {% endif %}

                <p class="mt-6 border-t border-black/10 pt-5 text-xs leading-5 text-gray-500">
                    {{ purchaseBenefits.footer }}
                </p>

            </aside>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const forms = document.querySelectorAll('.js-meta-add-to-cart');

        forms.forEach(function (form) {
            form.addEventListener('submit', function () {
                if (typeof fbq !== 'function') {
                    return;
                }

                const contentId = form.dataset.metaContentId || '';

                if (!contentId) {
                    return;
                }

                fbq('track', 'AddToCart', {
                    content_ids: [contentId],
                    content_type: 'product',
                    value: parseFloat(form.dataset.metaValue || '0'),
                    currency: form.dataset.metaCurrency || 'EUR'
                });
            });
        });
    });
</script>