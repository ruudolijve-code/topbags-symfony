{# templates/product/_hero_service.html.twig #}

{% set displayPrice = variant.displayPrice %}
{% set regularPrice = variant.price %}
{% set serviceImage = variant.images|first %}

<div class="relative left-1/2 right-1/2 w-screen -ml-[50vw] -mr-[50vw] bg-[#f4f1ea]">
    <div class="mx-auto max-w-7xl px-6 py-10 lg:py-12">

        {# =========================================================
           HERO GRID

           Desktop:
           afbeelding       4/12
           product/service  5/12
           waarom Topbags   3/12
           ========================================================= #}
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-8 lg:items-start">


            {# =====================================================
               1. AFBEELDING
               ===================================================== #}
            <div class="min-w-0 lg:col-span-4">
                <div class="flex aspect-[4/5] w-full items-center justify-center bg-white p-5 shadow-sm">

                    {% if serviceImage %}
                        <img
                            src="{{ asset(
                                imageBasePath|trim('/') ~ '/' ~ serviceImage.filename
                            ) }}"
                            alt="{{ product.name }}"
                            class="block max-h-full max-w-full object-contain"
                            loading="eager"
                        >
                    {% else %}
                        <div class="flex h-full w-full items-center justify-center text-sm text-gray-400">
                            Geen afbeelding beschikbaar
                        </div>
                    {% endif %}

                </div>
            </div>


            {# =====================================================
               2. DIENST / PRODUCT
               ===================================================== #}
            <div class="min-w-0 lg:col-span-5">

                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                    Topbags Service
                </div>

                <h1 class="mt-2 text-3xl font-semibold leading-tight text-gray-900 lg:text-[2rem]">
                    {{ product.name }}
                </h1>

                <p class="mt-4 text-sm leading-6 text-gray-700">
                    Is je koffer tijdens een vliegreis beschadigd?
                    Topbags stelt een deskundig schaderapport op dat je kunt gebruiken
                    bij het indienen van je schadeclaim bij de luchtvaartmaatschappij
                    of reisverzekering.
                </p>


                {# Wat ontvangt de klant? #}
                <ul class="mt-5 space-y-2 text-sm leading-5 text-gray-700">

                    <li class="flex gap-3">
                        <span class="shrink-0 font-bold text-amber-600">✓</span>
                        <span>Deskundige beoordeling van de schade</span>
                    </li>

                    <li class="flex gap-3">
                        <span class="shrink-0 font-bold text-amber-600">✓</span>
                        <span>
                            Indicatie of reparatie mogelijk en economisch verantwoord is
                        </span>
                    </li>

                    <li class="flex gap-3">
                        <span class="shrink-0 font-bold text-amber-600">✓</span>
                        <span>
                            Indicatie van reparatiekosten indien van toepassing
                        </span>
                    </li>

                    <li class="flex gap-3">
                        <span class="shrink-0 font-bold text-amber-600">✓</span>
                        <span>
                            Beoordeling bij onherstelbare schade
                        </span>
                    </li>

                    <li class="flex gap-3">
                        <span class="shrink-0 font-bold text-amber-600">✓</span>
                        <span>
                            Schaderapport digitaal per e-mail
                        </span>
                    </li>

                </ul>


                {# Prijs #}
                {% if displayPrice %}
                    <div class="mt-6">
                        <span class="text-2xl font-semibold text-gray-900">
                            € {{ displayPrice|number_format(2, ',', '.') }}
                        </span>
                    </div>
                {% endif %}


                {# Beschikbaarheid dienst #}
                <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                    <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-emerald-600"> </span>

                    <span class="font-semibold text-emerald-700">
                        Direct te bestellen
                    </span>

                    <span class="text-gray-500">
                        – digitaal schaderapport
                    </span>
                </div>

                <p class="mt-2 text-sm leading-5 text-gray-500">
                    Na je bestelling ontvang je instructies voor het aanleveren
                    van de benodigde gegevens en foto's.
                </p>


                {# Winkelwagen #}
                <div class="mt-6 flex flex-wrap items-center gap-4">

                    <form
                        method="post"
                        action="{{ path('cart_add') }}"
                        class="inline-flex js-meta-add-to-cart"
                        data-meta-content-id="{{ variant.variantSku|e('html_attr') }}"
                        data-meta-value="{{ variant.displayPrice|default(variant.price)|default(0)|number_format(2, '.', '') }}"
                        data-meta-currency="EUR"
                    >
                        <input
                            type="hidden"
                            name="variantSku"
                            value="{{ variant.variantSku }}"
                        >

                        <input
                            type="hidden"
                            name="qty"
                            value="1"
                        >

                        <button
                            type="submit"
                            class="inline-flex items-center justify-center rounded-full px-7 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
                            style="background-color: #ea7600;"
                        >
                            Schaderapport bestellen
                        </button>
                    </form>

                    <a
                        href="#details"
                        class="text-sm font-semibold text-gray-600 transition hover:text-gray-900"
                    >
                        Bekijk details →
                    </a>

                </div>


                {# Kleine USP's #}
                <div class="mt-7 grid grid-cols-3 gap-4 border-t border-black/10 pt-5">

                    <div>
                        <div class="text-xs font-semibold text-gray-900">
                            Kofferspecialist
                        </div>

                        <div class="mt-1 text-xs leading-4 text-gray-500">
                            Deskundige beoordeling
                        </div>
                    </div>

                    <div>
                        <div class="text-xs font-semibold text-gray-900">
                            Servicepunt
                        </div>

                        <div class="mt-1 text-xs leading-4 text-gray-500">
                            Voor diverse A-merken
                        </div>
                    </div>

                    <div>
                        <div class="text-xs font-semibold text-gray-900">
                            Digitaal rapport
                        </div>

                        <div class="mt-1 text-xs leading-4 text-gray-500">
                            Per e-mail ontvangen
                        </div>
                    </div>

                </div>

            </div>


            {# =====================================================
               3. WAAROM TOPBAGS
               ===================================================== #}
            <aside class="min-w-0 lg:col-span-3">

                <div class="rounded-2xl bg-white/65 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.08)]">

                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
                        Waarom Topbags?
                    </div>

                    <ul class="mt-5 space-y-4 text-sm leading-5 text-gray-700">

                        <li class="flex gap-3">
                            <span class="shrink-0 font-bold text-emerald-700">
                                ✓
                            </span>
                            <span>
                                Eigen reparatieservice in Hengelo
                            </span>
                        </li>

                        <li class="flex gap-3">
                            <span class="shrink-0 font-bold text-emerald-700">
                                ✓
                            </span>
                            <span>
                                Ervaren kofferspecialist
                            </span>
                        </li>

                        <li class="flex gap-3">
                            <span class="shrink-0 font-bold text-emerald-700">
                                ✓
                            </span>
                            <span>
                                Deskundige beoordeling van kofferschade
                            </span>
                        </li>

                        <li class="flex gap-3">
                            <span class="shrink-0 font-bold text-emerald-700">
                                ✓
                            </span>
                            <span>
                                Veilig online bestellen en betalen
                            </span>
                        </li>

                    </ul>


                    {# €25 verrekening #}
                    <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">

                        <div class="text-sm font-semibold leading-5 text-gray-900">
                            €25 retour bij aankoop van een nieuwe koffer
                        </div>

                        <p class="mt-2 text-sm leading-5 text-gray-700">
                            Koop je na het schaderapport een nieuwe koffer bij Topbags?
                            Dan verrekenen wij de volledige €25 met je aankoop.
                        </p>

                    </div>


                    {# Google Reviews #}
                    {% set googleReviews = google_business_reviews() %}

                    {% if googleReviews %}
                        <div class="mt-6 border-t border-black/10 pt-5">

                            <a
                                href="{{ googleReviews.googleMapsUrl }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group block rounded-xl bg-white p-4 transition hover:shadow-sm"
                                aria-label="Bekijk onze Google-reviews"
                            >
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">

                                    <span class="inline-flex h-5 w-16 shrink-0 items-center overflow-hidden
                                                [&_svg]:!h-5 [&_svg]:!w-auto [&_svg]:max-w-full">
                                        {% include 'partials/icons/google.svg.twig' %}
                                    </span>

                                    <div class="flex items-center gap-2">
                                        <span
                                            class="text-sm tracking-wide text-amber-500"
                                            aria-label="{{ googleReviews.rating|number_format(1, ',', '.') }} van 5 sterren"
                                        >
                                            ★★★★★
                                        </span>

                                        <strong class="font-semibold text-gray-900">
                                            {{ googleReviews.rating|number_format(1, ',', '.') }}
                                        </strong>

                                        <span class="text-sm text-gray-500">
                                            ({{ googleReviews.reviewCount }})
                                        </span>
                                    </div>

                                </div>

                                <p class="mt-2 text-xs leading-5 text-gray-500">
                                    Klanten beoordelen Holtkamp Tassen &amp; Koffers
                                    en Topbags.nl via Google
                                </p>

                            </a>

                        </div>
                    {% endif %}


                    <p class="mt-5 border-t border-black/10 pt-4 text-xs leading-5 text-gray-500">
                        Topbags &amp; Holtkamp Tassen &amp; Koffers –
                        service vanuit onze winkel in Hengelo.
                    </p>

                </div>

            </aside>

        </div>
    </div>
</div>


{# =========================================================
   META ADD TO CART
   ========================================================= #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const forms = document.querySelectorAll('.js-meta-add-to-cart');

        forms.forEach(function (form) {
            form.addEventListener('submit', function () {
                if (typeof fbq !== 'function') {
                    return;
                }

                const contentId = form.dataset.metaContentId || '';

                if (!contentId) {
                    return;
                }

                fbq('track', 'AddToCart', {
                    content_ids: [contentId],
                    content_type: 'product',
                    value: parseFloat(form.dataset.metaValue || '0'),
                    currency: form.dataset.metaCurrency || 'EUR'
                });
            });
        });
    });
</script>